# Banco (local: docker compose up -d). Em produção, a URL da Neon/Supabase com ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mutton?schema=public"

# Segredo do JWT do painel (gere um aleatório em produção: openssl rand -hex 32)
JWT_SECRET="troque-este-segredo-em-producao"

# Origem do front (Next.js). Aceita várias, separadas por vírgula.
FRONTEND_URL="http://localhost:3000"

# Liga as rotas /demo/* (lembretes manuais, resposta simulada, reset)
DEMO_MODE=true

# Porta da API
PORT=3333

# Opcional: URL pública da API, usada no icsUrl (senão, usa o host da requisição)
# PUBLIC_API_URL="https://mutton-api.onrender.com"

# Opcional: hora (fuso de SP) a partir da qual o job envia os lembretes da véspera. Padrão: 17
# REMINDER_HOUR=17

# WhatsApp oficial (Meta Cloud API). Sem TOKEN e PHONE_ID, o envio é simulado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# Opcional: valida a assinatura X-Hub-Signature-256 dos webhooks
WHATSAPP_APP_SECRET=
