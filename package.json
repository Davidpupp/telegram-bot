{
  "name": "mutton-agenda-api",
  "version": "0.1.0",
  "description": "API de agendamento online e acompanhamento cirúrgico da Clínica Mutton Oftalmologia (beta)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/seed/run.ts",
    "db:reset": "prisma migrate deploy && tsx src/seed/run.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davidpupp/telegram-bot.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Davidpupp/telegram-bot/issues"
  },
  "homepage": "https://github.com/Davidpupp/telegram-bot#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "node-cron": "^3.0.3",
    "pino-pretty": "^13.2.0",
    "zod": "^3.25.76",
    "tsx": "^4.23.15",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "private": true
}
